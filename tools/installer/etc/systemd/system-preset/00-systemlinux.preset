# systemLinux: the live image boots with no machine-id, so systemd applies presets on every live
# boot (and on an install's first boot). NetworkManager does the (only) network job here: keep
# systemd's own network, DNS and time daemons from being enabled next to it.
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-*
disable systemd-network-generator.service
disable systemd-resolved.service
disable systemd-timesyncd.service
enable NetworkManager.service
